# Copy to .env and fill in. .env is gitignored.
#
# Supabase: Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the DIRECT connection on port 5432, not the pooler on 6543 -- the pooler
# runs in transaction mode and rejects the multi-statement DDL the loader sends.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Read-only values used by the hosted web dashboard. Safe to publish: the anon
# key is protected by row-level security policies that grant SELECT only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
