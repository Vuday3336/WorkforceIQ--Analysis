# Copy to .env and fill in. .env is gitignored.
#
# Supabase: Dashboard -> Project Settings -> Database -> Connection string
#
# USE THE SESSION POOLER (port 5432). Three endpoints are offered and only one
# of them works for this loader:
#
#   session pooler      pooler.supabase.com:5432   <- use this. IPv4, session
#                                                     mode, handles the
#                                                     multi-statement DDL.
#   transaction pooler  pooler.supabase.com:6543   rejects multi-statement DDL
#   direct              db.<ref>.supabase.co:5432  IPv6-only since 2024, so it
#                                                  fails on most home networks
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Read-only values used by the hosted web dashboard. Safe to publish: the anon
# key is protected by row-level security policies that grant SELECT only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
