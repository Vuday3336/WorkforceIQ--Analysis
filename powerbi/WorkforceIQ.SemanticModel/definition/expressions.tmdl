/// Folder holding the exported CSVs the model imports.
/// Point this at <repo>\data\powerbi after cloning:
///   Power BI > Transform data > Manage parameters > DataFolder
/// Regenerate the files with: python generators/export_for_powerbi.py
expression DataFolder = "D:\\Projects\\WorkForceIq\\data\\powerbi" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 723841ed-3e2c-b1f0-0216-edc7aceb409d
	annotation PBI_ResultType = Text

/// Kept for the live-database variant described in
/// REPORT_BUILD_GUIDE.md. Unused by the default file import: the
/// Supabase pooler certificate is not chained to a root Windows
/// trusts, so a PostgreSQL connection needs either "Encrypt
/// connection" unticked or the Supabase CA installed.
/// Use the SESSION pooler on 5432, never the transaction pooler on 6543.
expression ServerName = "aws-0-ap-south-1.pooler.supabase.com:5432" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: a6139704-93ec-ab8b-359b-31f54cb13335
	annotation PBI_ResultType = Text

/// Database name. On Supabase this is always "postgres".
expression DatabaseName = "postgres" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 2b655a44-bdc5-6ea6-97dd-cdbbcb8f1e78
	annotation PBI_ResultType = Text
